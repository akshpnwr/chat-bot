# Postgres (Neon). Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# better-auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

PORT=3000
# Direct (non-pooled) URL, used for migrations.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Disposable Postgres branch for integration tests (wiped by the suite).
TEST_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
TEST_DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Object storage for image attachments (S3-compatible; Neon object storage).
# Uploads are presigned and go browser-to-bucket, never through the app server.
STORAGE_ENDPOINT="https://br-xxxx.storage.c-2.us-east-2.aws.neon.tech"
STORAGE_BUCKET="chat-attachments"
STORAGE_REGION="us-east-2"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
