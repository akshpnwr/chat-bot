# Postgres (Neon). Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# better-auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

PORT=3000
# Direct (non-pooled) URL, used for migrations.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Disposable Postgres branch for integration tests (wiped by the suite).
TEST_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
TEST_DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Object storage for image attachments (S3-compatible; Neon object storage).
# Uploads are presigned and go browser-to-bucket, never through the app server.
STORAGE_ENDPOINT="https://br-xxxx.storage.c-2.us-east-2.aws.neon.tech"
STORAGE_BUCKET="chat-attachments"
STORAGE_REGION="us-east-2"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# GIF search. Leave this empty: it addressed the Tenor API, which Google shut
# down on 30 June 2026, so no value here does anything. Stickers are bundled and
# need no credential, so a checkout is a working application whose GIF tab
# reports itself unavailable. Restoring GIFs needs a different provider behind
# the same adapter -- see issue #17.
#
# Kept because the seam is still right: the key is read only on the server and
# never reaches the browser, which is why search is proxied through
# /api/gifs/search rather than called from the client. Whatever replaces Tenor
# wants the same treatment.
GIFS_API_KEY=""
