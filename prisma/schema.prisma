// Domain vocabulary follows CONTEXT.md. Sequencing follows ADR-0002.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  participants Participant[]
  messages     Message[]
  sessions     Session[]
  accounts     Account[]

  @@map("user")
}

/// A durable one-to-one thread between exactly two participants. Created once
/// and reused; there is never more than one Conversation for a given pair.
model Conversation {
  id        String   @id @default(cuid())
  /// The two participants' user ids, sorted and joined. A pair yields the same
  /// key whichever side opens the thread, so the unique constraint below is
  /// what enforces "never more than one Conversation for a given pair" --
  /// rather than a read-then-write check two concurrent opens could both pass.
  pairKey   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants Participant[]
  messages     Message[]

  @@map("conversation")
}

/// A User's membership in a Conversation, carrying that user's own
/// per-conversation state -- their Read Mark.
model Participant {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  /// The Read Mark: the highest Message seq this Participant has read.
  /// Monotonic -- it never moves backwards. 0 means nothing read yet.
  lastReadSeq    BigInt   @default(0)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // One Participant per user per Conversation.
  @@unique([userId, conversationId])
  // Serves listing a user's Conversations.
  @@index([userId])
  @@map("participant")
}

enum MessageKind {
  TEXT
  IMAGE
  GIF
  STICKER
}

enum MessageStatus {
  /// Accepted and stored, but not yet cleared for the recipient to see
  /// (an image awaiting classification).
  PENDING
  /// Cleared for delivery. Recipient-facing queries filter on this.
  VISIBLE
  /// Failed moderation. Never surfaced to the recipient by any route.
  REJECTED
}

/// A single unit of content sent by one Participant into a Conversation.
/// Immutable once accepted.
model Message {
  id             String        @id @default(cuid())
  /// The universal cursor (ADR-0002): sort key, pagination cursor, Sync Cursor,
  /// and the value compared against a Read Mark. A global BIGSERIAL, so it is
  /// strictly monotonic and free of the ties a timestamp would produce.
  seq            BigInt        @default(autoincrement())
  conversationId String
  senderId       String
  kind           MessageKind   @default(TEXT)
  status         MessageStatus @default(VISIBLE)
  body           String?

  /// Intrinsic dimensions are stored so the virtualized list can reserve space
  /// before an asset loads, preventing scroll displacement.
  assetUrl    String?
  assetWidth  Int?
  assetHeight Int?

  /// The idempotency key, generated by the client before the Message leaves the
  /// browser. The unique constraint below is what makes a retry return the
  /// original Message rather than creating a second one.
  clientMessageId String
  /// Why moderation rejected this Message, shown to the sender.
  moderationReason String?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Idempotency, arbitrated by the database rather than by application
  // bookkeeping that could race.
  @@unique([conversationId, clientMessageId])
  // Serves pagination, reconnect sync and unread counts in one index.
  @@index([conversationId, seq(sort: Desc)])
  @@map("message")
}

// --- better-auth tables ---

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  /// Required by better-auth 1.7: identifies the credential issuer. For the
  /// email/password provider this is a synthetic value it generates itself.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
