{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "incremental": false,
    "allowImportingTsExtensions": false
  },
  "include": ["server/**/*.ts", "src/lib/**/*.ts", "src/server/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
